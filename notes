    <script>
        (function() {
            // --- storage key ---
            const STORAGE_KEY = 'itachi_dark_notes_v3';

            // --- DOM elements ---
            const notesGrid = document.getElementById('notesGrid');
            const noteInput = document.getElementById('noteInput');
            const saveBtn = document.getElementById('saveNoteBtn');

            // --- state ---
            let notes = [];

            // --- create floating embers ---
            function createEmbers() {
                const container = document.getElementById('emberContainer');
                const EMBER_COUNT = 18;
                for (let i = 0; i < EMBER_COUNT; i++) {
                    const ember = document.createElement('div');
                    ember.className = 'ember';
                    // random positioning
                    ember.style.left = Math.random() * 100 + 'vw';
                    ember.style.bottom = '-10px';
                    // random size
                    const size = 2 + Math.random() * 3;
                    ember.style.width = size + 'px';
                    ember.style.height = size + 'px';
                    // random animation
                    const duration = 12 + Math.random() * 20;
                    const delay = Math.random() * 15;
                    ember.style.animation = `floatEmber ${duration}s ${delay}s linear infinite`;
                    // random color variation
                    const colors = ['#b33', '#c44', '#a22', '#d55'];
                    ember.style.background = colors[Math.floor(Math.random() * colors.length)];
                    container.appendChild(ember);
                }
            }

            // --- load from localStorage ---
            function loadNotes() {
                try {
                    const stored = localStorage.getItem(STORAGE_KEY);
                    if (stored) {
                        notes = JSON.parse(stored);
                    } else {
                        // seed with aesthetic notes
                        notes = [
                            { id: Date.now() + 1, text: "Those who forgive themselves, and are able to accept their true nature... They are the strong ones.", timestamp: new Date(Date.now() - 86400000).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) },
                            { id: Date.now() + 2, text: "It is not the face that makes someone a monster; it's the choices they make.", timestamp: new Date(Date.now() - 3600000).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) },
                        ];
                        saveNotesToStorage();
                    }
                } catch (e) {
                    console.warn('failed to load notes', e);
                    notes = [];
                }
                renderNotes();
            }

            // --- save to localStorage ---
            function saveNotesToStorage() {
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(notes));
                } catch (e) {
                    console.warn('could not save notes', e);
                }
            }

            // --- format timestamp ---
            function formatTimestamp(ts) {
                if (!ts) return 'just now';
                if (typeof ts === 'string') return ts;
                try {
                    return new Date(ts).toLocaleString(undefined, { 
                        month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                    });
                } catch {
                    return 'unknown';
                }
            }

            // --- create note card HTML ---
            function createNoteCard(note) {
                const card = document.createElement('div');
                card.className = 'note-card';
                card.dataset.id = note.id;

                const textDiv = document.createElement('div');
                textDiv.className = 'note-text';
                textDiv.textContent = note.text;

                const footer = document.createElement('div');
                footer.className = 'note-footer';

                const timeSpan = document.createElement('span');
                timeSpan.className = 'note-time';
                timeSpan.textContent = formatTimestamp(note.timestamp);

                const deleteBtn = document.createElement('button');
                deleteBtn.className = 'delete-btn';
                deleteBtn.setAttribute('aria-label', 'Delete note');
                deleteBtn.innerHTML = '<i class="fas fa-trash-alt"></i>';
                deleteBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    deleteNoteById(note.id);
                });

                footer.appendChild(timeSpan);
                footer.appendChild(deleteBtn);
                card.appendChild(textDiv);
                card.appendChild(footer);

                return card;
            }

            // --- render all notes ---
            function renderNotes() {
                notesGrid.innerHTML = '';

                if (!notes.length) {
                    const emptyDiv = document.createElement('div');
                    emptyDiv.className = 'empty-state';
                    emptyDiv.textContent = '✧ no notes yet — like the moon, quietly waiting ✧';
                    notesGrid.appendChild(emptyDiv);
                    return;
                }

                // sort by newest first
                const sorted = [...notes].sort((a, b) => b.id - a.id);

                sorted.forEach((note, index) => {
                    const card = createNoteCard(note);
                    // stagger animation
                    card.style.animationDelay = (index * 0.06) + 's';
                    notesGrid.appendChild(card);
                });
            }

            // --- add new note ---
            function addNote() {
                const text = noteInput.value.trim();
                if (!text) {
                    // shake animation on empty
                    noteInput.style.transition = '0.25s';
                    noteInput.style.borderColor = '#b33';
                    noteInput.style.boxShadow = '0 0 32px #a33';
                    noteInput.style.transform = 'translateX(-4px)';
                    setTimeout(() => {
                        noteInput.style.transform = 'translateX(4px)';
                    }, 80);
                    setTimeout(() => {
                        noteInput.style.transform = 'translateX(0)';
                        noteInput.style.borderColor = 'transparent';
                        noteInput.style.boxShadow = 'none';
                    }, 240);
                    return;
                }

                const newNote = {
                    id: Date.now(),
                    text: text,
                    timestamp: new Date().toLocaleString(undefined, { 
                        month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                    })
                };

                notes.push(newNote);
                saveNotesToStorage();
                renderNotes();
                noteInput.value = '';

                // smooth scroll to new note
                setTimeout(() => {
                    const firstCard = notesGrid.querySelector('.note-card');
                    if (firstCard) {
                        firstCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                }, 80);
            }

            // --- delete note by id ---
            function deleteNoteById(id) {
                const card = document.querySelector(`.note-card[data-id="${id}"]`);
                if (card) {
                    card.style.transition = 'opacity 0.35s, transform 0.35s cubic-bezier(0.2, 0.9, 0.4, 1)';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.8) translateY(20px) rotateX(-10deg)';
                    setTimeout(() => {
                        notes = notes.filter(note => note.id !== id);
                        saveNotesToStorage();
                        renderNotes();
                    }, 320);
                } else {
                    notes = notes.filter(note => note.id !== id);
                    saveNotesToStorage();
                    renderNotes();
                }
            }

            // --- event listeners ---
            saveBtn.addEventListener('click', addNote);

            noteInput.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    e.preventDefault();
                    addNote();
                }
            });

            // --- initialize ---
            createEmbers();
            loadNotes();
        })();
    </script>
</body>
</html>
